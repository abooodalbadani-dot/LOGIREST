{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/setup.ts"],
  "testTimeout": 30000,
  "moduleNameMapper": {
    "^@logirest/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts",
    "^@logirest/shared-types/(.*)$": "<rootDir>/../../../packages/shared-types/src/$1"
  }
}

