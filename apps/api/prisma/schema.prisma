generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GM
  INV_MGR
  WH_KEEPER
  PROC_OFFICER
  APPROVER
  AUDITOR
  VIEWER
  KITCHEN_CHIEF
  STORE_MGR
}

enum LotStatus {
  ACTIVE
  HOLD
  EXPIRED
  QUARANTINE
}

enum AdjustmentDirection {
  IN
  OUT
}

enum AdjustmentReason {
  THEFT
  DAMAGE
  SPOILAGE
  CORRECTION
  ADMIN_OVERRIDE
}

enum DocumentType {
  PURCHASE_REQUEST
  PURCHASE_ORDER
  GOODS_RECEIVED_NOTE
  INVENTORY_ISSUE
  TRANSFER
  ADJUSTMENT
  KITCHEN_REQUEST
  STOCKTAKE
}

enum LockType {
  STOCKTAKE
  MANUAL
}

enum LockStatus {
  ACTIVE
  STALE
  RELEASED
}

enum StocktakeStatus {
  DRAFT
  STARTED
  COUNTING
  REVIEW
  APPROVED
  POSTED
  CLOSED
  CANCELLED
}

// ─── Tier 1: Master Data ───────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until")
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  warehouseScopes     UserWarehouseScope[]
  purchaseRequests    PurchaseRequest[]
  approvalEvents      ApprovalEvent[]
  warehouseLocks      WarehouseLock[]
  stocktakeCounts     StocktakeCount[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserWarehouseScope {
  id          String @id @default(uuid())
  userId      String
  warehouseId String
  version     Int    @default(1)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@map("user_warehouse_scopes")
}

model RefreshToken {
  id            String   @id @default(uuid())
  tokenHash     String   @unique
  userId        String
  sessionId     String
  parentTokenId String?
  expiresAt     DateTime
  isRevoked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  version       Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt]) // Enables efficient expired-token cleanup queries
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Branch {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  version   Int      @default(1)
  createdAt DateTime @default(now())

  warehouses        Warehouse[]
  departments       Department[]
  purchaseRequests  PurchaseRequest[]
  documentSequences DocumentSequence[]

  @@map("branches")
}

model Warehouse {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  code      String   @unique
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())

  branch             Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userScopes         UserWarehouseScope[]
  purchaseRequests   PurchaseRequest[]
  goodsReceivedNotes GoodsReceivedNote[]
  inventoryIssues    InventoryIssue[]
  transfersFrom      Transfer[]           @relation("TransferFrom")
  transfersTo        Transfer[]           @relation("TransferTo")
  adjustments        Adjustment[]
  kitchenRequests    KitchenRequest[]
  warehouseItems     WarehouseItem[]
  warehouseItemLots  WarehouseItemLot[]
  stockLedgers       StockLedger[]
  costLedgers        CostLedger[]
  warehouseLocks     WarehouseLock[]
  stocktakeSessions  StocktakeSession[]
  yieldBatches       YieldBatch[]

  @@map("warehouses")
}

model Department {
  id       String @id @default(uuid())
  branchId String
  name     String
  version  Int    @default(1)

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryIssues InventoryIssue[]
  kitchenRequests KitchenRequest[]

  @@map("departments")
}

model Category {
  id      String @id @default(uuid())
  name    String @unique
  version Int    @default(1)

  items Item[]

  @@map("categories")
}

model UnitOfMeasure {
  id      String @id @default(uuid())
  name    String @unique
  code    String @unique
  version Int    @default(1)

  items Item[]

  @@map("units_of_measure")
}

model Supplier {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  contactEmail String?
  contactName  String?
  contactPhone String?
  isActive     Boolean @default(true)
  version      Int     @default(1)

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Currency {
  id      String  @id @default(uuid())
  code    String  @unique
  name    String
  isBase  Boolean @default(false)
  version Int     @default(1)

  purchaseOrders PurchaseOrder[]
  fxRatesFrom    FXRate[]        @relation("FXFrom")
  fxRatesTo      FXRate[]        @relation("FXTo")

  @@map("currencies")
}

model FXRate {
  id             String   @id @default(uuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal  @db.Decimal(18, 6)
  effectiveFrom  DateTime
  version        Int      @default(1)

  fromCurrency Currency @relation("FXFrom", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency   Currency @relation("FXTo", fields: [toCurrencyId], references: [id], onDelete: Restrict)

  @@unique([fromCurrencyId, toCurrencyId, effectiveFrom])
  @@map("fx_rates")
}

model Item {
  id         String   @id @default(uuid())
  categoryId String
  uomId      String
  name       String
  sku        String   @unique
  isBatched  Boolean  @default(false)
  hasExpiry  Boolean  @default(false)
  isActive   Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  reorderPoint Decimal? @db.Decimal(18, 4)

  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitOfMeasure       UnitOfMeasure        @relation(fields: [uomId], references: [id], onDelete: Restrict)
  barcodeMappings     BarcodeMapping[]
  prLines             PRLine[]
  poLines             POLine[]
  grnLines            GRNLine[]
  issueLines          InventoryIssueLine[]
  transferLines       TransferLine[]
  adjustmentLines     AdjustmentLine[]
  kitchenRequestItems KitchenRequestItem[]
  lots                Lot[]
  warehouseItems      WarehouseItem[]
  warehouseItemLots   WarehouseItemLot[]
  stockLedgers        StockLedger[]
  costLedgers         CostLedger[]
  stocktakeCounts     StocktakeCount[]
  stocktakeSnapshots  StocktakeSnapshot[]

  @@map("items")
}

model BarcodeMapping {
  id      String @id @default(uuid())
  itemId  String
  barcode String @unique
  version Int    @default(1)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("barcode_mappings")
}

// ─── Tier 2: Transaction Documents ─────────────────────────────────

model PurchaseRequest {
  id            String   @id @default(uuid())
  requestNumber String   @unique
  branchId      String
  warehouseId   String
  status        String   @default("DRAFT")
  createdById   String
  version       Int      @default(1)
  createdAt     DateTime @default(now())

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines          PRLine[]
  purchaseOrders PurchaseOrder[]

  @@map("purchase_requests")
}

model PRLine {
  id       String  @id @default(uuid())
  prId     String
  itemId   String
  quantity Decimal @db.Decimal(18, 4)

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("pr_lines")
}

model PurchaseOrder {
  id         String   @id @default(uuid())
  poNumber   String   @unique
  prId       String?  @unique
  supplierId String
  status     String   @default("DRAFT")
  currencyId String
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  purchaseRequest    PurchaseRequest?    @relation(fields: [prId], references: [id], onDelete: SetNull)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currency           Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  lines              POLine[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@map("purchase_orders")
}

model POLine {
  id        String  @id @default(uuid())
  poId      String
  itemId    String
  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("po_lines")
}

model GoodsReceivedNote {
  id          String   @id @default(uuid())
  grnNumber   String   @unique
  poId        String
  warehouseId String
  status      String   @default("DRAFT")
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines         GRNLine[]

  @@index([status])
  @@map("goods_received_notes")
}

model GRNLine {
  id               String  @id @default(uuid())
  grnId            String
  itemId           String
  quantityReceived Decimal @db.Decimal(18, 4)
  unitPrice        Decimal @db.Decimal(18, 4)
  lotId            String?

  goodsReceivedNote GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item              Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot               Lot?              @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@map("grn_lines")
}

model InventoryIssue {
  id           String   @id @default(uuid())
  issueNumber  String   @unique
  warehouseId  String
  departmentId String
  status       String   @default("DRAFT")
  version      Int      @default(1)
  createdAt    DateTime @default(now())

  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  department     Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  lines          InventoryIssueLine[]
  kitchenRequest KitchenRequest?

  @@map("inventory_issues")
}

model InventoryIssueLine {
  id       String  @id @default(uuid())
  issueId  String
  itemId   String
  quantity Decimal @db.Decimal(18, 4)

  inventoryIssue InventoryIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotAllocations LotAllocation[]

  @@map("inventory_issue_lines")
}

model LotAllocation {
  id                String  @id @default(uuid())
  issueLineId       String?
  transferLineId    String?
  lotId             String
  quantityAllocated Decimal @db.Decimal(18, 4)

  issueLine    InventoryIssueLine? @relation(fields: [issueLineId], references: [id], onDelete: Cascade)
  transferLine TransferLine?       @relation(fields: [transferLineId], references: [id], onDelete: Cascade)
  lot          Lot                 @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([transferLineId])
  @@index([issueLineId])
  @@map("lot_allocations")
}

model Transfer {
  id              String   @id @default(uuid())
  transferNumber  String   @unique
  fromWarehouseId String
  toWarehouseId   String
  status          String   @default("DRAFT")
  version         Int      @default(1)
  createdAt       DateTime @default(now())

  fromWarehouse Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  lines         TransferLine[]

  @@map("transfers")
}

model TransferLine {
  id               String   @id @default(uuid())
  transferId       String
  itemId           String
  quantityShipped  Decimal  @db.Decimal(18, 4)
  quantityReceived Decimal? @db.Decimal(18, 4)
  unitCost         Decimal? @db.Decimal(18, 4)
  varianceReason   String?

  transfer       Transfer        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotAllocations LotAllocation[]

  @@map("transfer_lines")
}

model Adjustment {
  id               String   @id @default(uuid())
  adjustmentNumber String   @unique
  warehouseId      String
  status           String   @default("DRAFT")
  version          Int      @default(1)
  createdAt        DateTime @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     AdjustmentLine[]

  @@map("adjustments")
}

model AdjustmentLine {
  id           String              @id @default(uuid())
  adjustmentId String
  itemId       String
  lotId        String?
  quantity     Decimal             @db.Decimal(18, 4)
  direction    AdjustmentDirection
  reason       AdjustmentReason
  unitCost     Decimal?            @db.Decimal(18, 4)

  adjustment Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot        Lot?       @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@map("adjustment_lines")
}

model KitchenRequest {
  id            String   @id @default(uuid())
  requestNumber String   @unique
  departmentId  String
  warehouseId   String
  status        String   @default("DRAFT")
  version       Int      @default(1)
  issueId       String?  @unique @map("issue_id")
  createdAt     DateTime @default(now())

  department     Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryIssue InventoryIssue?      @relation(fields: [issueId], references: [id])
  items          KitchenRequestItem[]

  @@map("kitchen_requests")
}

model YieldBatch {
  id            String     @id @default(uuid())
  recipeName    String     @map("recipe_name")
  category      String
  warehouseId   String?    @map("warehouse_id")
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  inputQty      Float      @map("input_qty")
  outputQty     Float      @map("output_qty")
  wasteQty      Float      @map("waste_qty")
  yieldPct      Float      @map("yield_pct")
  standardYield Float      @map("standard_yield")
  efficiency    Float
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([warehouseId])
  @@map("yield_batches")
}

model KitchenRequestItem {
  id                String  @id @default(uuid())
  requestId         String
  itemId            String
  quantityRequested Decimal @db.Decimal(18, 4)
  quantityFulfilled Decimal @db.Decimal(18, 4)

  kitchenRequest KitchenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("kitchen_request_items")
}

model ApprovalEvent {
  id              String       @id @default(uuid())
  documentId      String
  documentType    DocumentType
  fromStatus      String
  toStatus        String
  actionPerformed String
  userId          String
  stepNumber      Int
  userRole        Role
  comments        String?
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Composite index for workflow step counting (used in executeTransition)
  @@index([documentId, documentType])
  @@map("approval_events")
}

// ─── Tier 3 & 4: Live Inventory Position & Lots ────────────────────

model Lot {
  id           String    @id @default(uuid())
  itemId       String
  lotNumber    String    @unique
  receivedDate DateTime  @default(now())
  expiryDate   DateTime?
  status       LotStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())

  item               Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  grnLines           GRNLine[]
  lotAllocations     LotAllocation[]
  adjustmentLines    AdjustmentLine[]
  warehouseItemLots  WarehouseItemLot[]
  stockLedgers       StockLedger[]
  stocktakeCounts    StocktakeCount[]
  stocktakeSnapshots StocktakeSnapshot[]

  @@index([itemId, expiryDate(sort: Asc)])
  @@map("lots")
}

model WarehouseItem {
  warehouseId  String
  itemId       String
  qtyOnHand    Decimal  @default(0) @db.Decimal(18, 4)
  qtyAllocated Decimal  @default(0) @db.Decimal(18, 4)
  wac          Decimal  @default(0) @db.Decimal(18, 4)
  isFrozen     Boolean  @default(false) @map("is_frozen")
  updatedAt    DateTime @updatedAt

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lots      WarehouseItemLot[]

  @@id([warehouseId, itemId])
  @@map("warehouse_items")
}

model WarehouseItemLot {
  warehouseId  String
  itemId       String
  lotId        String
  qtyOnHand    Decimal  @default(0) @db.Decimal(18, 4)
  qtyAllocated Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt    DateTime @updatedAt

  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot           Lot           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouseItem WarehouseItem @relation(fields: [warehouseId, itemId], references: [warehouseId, itemId], onDelete: Cascade)

  @@id([warehouseId, itemId, lotId])
  @@index([warehouseId, itemId])
  @@map("warehouse_item_lots")
}

// ─── Tier 5: Immutable Ledgers ─────────────────────────────────────

model StockLedger {
  id             String       @id @default(uuid())
  postedAt       DateTime     @default(now())
  warehouseId    String
  itemId         String
  lotId          String?
  quantity       Decimal      @db.Decimal(18, 4)
  documentId     String
  documentType   DocumentType
  idempotencyKey String?      @unique

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot       Lot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([warehouseId, itemId, postedAt(sort: Desc)])
  @@index([warehouseId, itemId])
  @@index([documentId])
  @@map("stock_ledger")
}

model CostLedger {
  id             String       @id @default(uuid())
  postedAt       DateTime     @default(now())
  warehouseId    String
  itemId         String
  quantity       Decimal      @db.Decimal(18, 4)
  unitPrice      Decimal      @db.Decimal(18, 4)
  newWac         Decimal      @db.Decimal(18, 4)
  documentId     String
  documentType   DocumentType
  idempotencyKey String?      @unique

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([warehouseId, itemId, postedAt(sort: Desc)])
  @@index([documentId])
  @@index([documentId, documentType])
  @@map("cost_ledger")
}

// ─── Tier 6: Control & Security ────────────────────────────────────

model WarehouseLock {
  id          String     @id @default(uuid())
  warehouseId String
  lockType    LockType
  status      LockStatus @default(ACTIVE)
  lockedById  String
  expiresAt   DateTime
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lockedBy  User      @relation(fields: [lockedById], references: [id], onDelete: Restrict)

  @@index([isActive, expiresAt])
  @@index([warehouseId, isActive])
  @@map("warehouse_locks")
}

model IdempotencyLog {
  key          String   @id
  responseBody String
  statusCode   Int
  createdAt    DateTime @default(now())

  @@map("idempotency_logs")
}

model AuditLog {
  id              String   @id @default(uuid())
  userId          String?
  action          String
  targetTable     String
  targetId        String
  beforeStateJson String
  afterStateJson  String
  ipAddress       String?
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Indexes for incident investigation and audit queries
  @@index([targetTable, targetId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model StocktakeSession {
  id            String          @id @default(uuid())
  sessionNumber String          @unique
  warehouseId   String
  status        StocktakeStatus @default(DRAFT)
  version       Int             @default(1)
  createdAt     DateTime        @default(now())

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  counts    StocktakeCount[]
  snapshots StocktakeSnapshot[]

  @@map("stocktake_sessions")
}

model StocktakeCount {
  id          String   @id @default(uuid())
  sessionId   String
  itemId      String
  lotId       String?
  qtyCounted  Decimal  @db.Decimal(18, 4)
  countedById String
  countedAt   DateTime @default(now())

  session   StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item      Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot       Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  countedBy User             @relation(fields: [countedById], references: [id], onDelete: Restrict)

  @@map("stocktake_counts")
}

model StocktakeSnapshot {
  id          String   @id @default(uuid())
  sessionId   String
  itemId      String
  lotId       String?
  qtySnapshot Decimal  @db.Decimal(18, 4)
  wacSnapshot Decimal  @db.Decimal(18, 4)
  createdAt   DateTime @default(now())

  session StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot     Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@map("stocktake_snapshots")
}

model NotificationLog {
  id           String        @id @default(uuid())
  targetRole   Role
  warehouseId  String?
  message      String
  isRead       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  documentType DocumentType?
  documentId   String?

  @@index([targetRole, isRead])
  @@index([warehouseId])
  @@index([createdAt(sort: Desc)]) // Enables efficient TTL-based cleanup
  @@map("notification_logs")
}

model DocumentSequence {
  id              String       @id @default(uuid())
  branchId        String       @map("branch_id")
  documentType    DocumentType @map("document_type")
  year            Int
  currentSequence Int          @default(0) @map("current_sequence")
  prefix          String
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([documentType, year, branchId])
  @@map("document_sequences")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  status      String    @default("PENDING") // PENDING | SUCCEEDED | FAILED
  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([status, createdAt])
  @@map("outbox_events")
}

model ReconciliationRun {
  id                 String   @id @default(uuid())
  ranAt              DateTime @default(now())
  itemsChecked       Int
  discrepanciesFound   Int
  lotDiscrepanciesFound Int @default(0) @map("lot_discrepancies_found")
  frozenItems          String[]
  durationMs         Int

  @@map("reconciliation_runs")
}

model SystemSetting {
  key       String   @id
  value     String   // Encrypted configuration string
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model AuditLogArchive {
  id              String   @id
  userId          String?
  action          String
  targetTable     String
  targetId        String
  beforeStateJson String
  afterStateJson  String
  ipAddress       String?
  createdAt       DateTime

  @@map("audit_logs_archive")
}

model StockLedgerArchive {
  id             String       @id
  postedAt       DateTime
  warehouseId    String
  itemId         String
  lotId          String?
  quantity       Decimal      @db.Decimal(18, 4)
  documentId     String
  documentType   DocumentType
  idempotencyKey String?

  @@map("stock_ledger_archive")
}


