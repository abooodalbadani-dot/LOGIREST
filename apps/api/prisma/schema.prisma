generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GM
  INV_MGR
  WH_KEEPER
  PROC_OFFICER
  APPROVER
  AUDITOR
  VIEWER
  KITCHEN_CHIEF
  STORE_MGR
  BRANCH_MGR
  PROC_MGR
}

enum LotStatus {
  ACTIVE
  HOLD
  EXPIRED
  QUARANTINE
}

enum AdjustmentDirection {
  IN
  OUT
}

enum AdjustmentReason {
  THEFT
  DAMAGE
  SPOILAGE
  CORRECTION
  ADMIN_OVERRIDE
}

enum DocumentType {
  PURCHASE_REQUEST
  PURCHASE_ORDER
  GOODS_RECEIVED_NOTE
  INVENTORY_ISSUE
  TRANSFER
  ADJUSTMENT
  KITCHEN_REQUEST
  STOCKTAKE
  YIELD_BATCH
}

enum LockType {
  STOCKTAKE
  MANUAL
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum PRStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum POStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIAL
  PARTIALLY_RECEIVED
  FULFILLED
  CANCELLED
}

enum GRStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RECEIVED
  POSTED
  VOIDED
  CANCELLED
}

enum IssueStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  VOIDED
  CANCELLED
}

enum AdjStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  VOIDED
  CANCELLED
}

enum LockStatus {
  ACTIVE
  STALE
  RELEASED
}

enum StocktakeStatus {
  DRAFT
  STARTED
  COUNTING
  REVIEW
  APPROVED
  POSTED
  CLOSED
  CANCELLED
}

enum LandedCostStatus {
  DRAFT
  PROCESSING
  POSTED
}

enum AllocationMethod {
  VALUE
  QUANTITY
  WEIGHT
  VOLUME
}

enum OutboxStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// ─── Tier 1: Master Data ───────────────────────────────────────────

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String
  name                    String
  role                    Role
  isActive                Boolean   @default(true)
  avatarUrl               String?   @map("avatar_url")
  failedLoginAttempts     Int       @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime? @map("locked_until")
  phone                   String?
  locale                  String    @default("ar")
  themePreferences        String    @default("light") @map("theme_preferences")
  notificationPreferences Json?     @map("notification_preferences")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  warehouseScopes           UserWarehouseScope[]
  branchScopes              UserBranchScope[]
  departmentScopes          UserDepartmentScope[]
  purchaseRequests          PurchaseRequest[]
  approvalEvents            ApprovalEvent[]
  warehouseLocks            WarehouseLock[]
  stocktakeCounts           StocktakeCount[]
  auditLogs                 AuditLog[]
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  createdLandedCostVouchers LandedCostVoucher[]   @relation("CreatedVouchers")
  grnCreated                GoodsReceivedNote[]   @relation("GRNCreatedBy")
  kitchenRequests           KitchenRequest[]
  inventoryIssues           InventoryIssue[]
  adjustments               Adjustment[]

  @@map("users")
}

model UserWarehouseScope {
  id          String @id @default(uuid())
  userId      String
  warehouseId String
  version     Int    @default(1)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@map("user_warehouse_scopes")
}

model UserBranchScope {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  branchId String @map("branch_id")
  version  Int    @default(1)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branch_scopes")
}

model UserDepartmentScope {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  departmentId String @map("department_id")
  version      Int    @default(1)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("user_department_scopes")
}

model RefreshToken {
  id            String   @id @default(uuid())
  tokenHash     String   @unique
  userId        String
  sessionId     String
  parentTokenId String?
  expiresAt     DateTime
  isRevoked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  version       Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt]) // Enables efficient expired-token cleanup queries
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Branch {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())

  warehouses        Warehouse[]
  departments       Department[]
  purchaseRequests  PurchaseRequest[]
  documentSequences DocumentSequence[]
  userScopes        UserBranchScope[]

  @@map("branches")
}

model Warehouse {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  code      String   @unique
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())

  branch             Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userScopes         UserWarehouseScope[]
  purchaseRequests   PurchaseRequest[]
  goodsReceivedNotes GoodsReceivedNote[]
  inventoryIssues    InventoryIssue[]
  transfersFrom      Transfer[]           @relation("TransferFrom")
  transfersTo        Transfer[]           @relation("TransferTo")
  adjustments        Adjustment[]
  kitchenRequests    KitchenRequest[]
  warehouseItems     WarehouseItem[]
  warehouseItemLots  WarehouseItemLot[]
  stockLedgers       StockLedger[]
  costLedgers        CostLedger[]
  warehouseLocks     WarehouseLock[]
  stocktakeSessions  StocktakeSession[]
  yieldBatches       YieldBatch[]
  purchaseOrders     PurchaseOrder[]

  @@map("warehouses")
}

model Department {
  id       String  @id @default(uuid())
  branchId String
  name     String
  isActive Boolean @default(true)
  version  Int     @default(1)

  branch           Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryIssues  InventoryIssue[]
  kitchenRequests  KitchenRequest[]
  userScopes       UserDepartmentScope[]
  purchaseRequests PurchaseRequest[]

  @@map("departments")
}

model Category {
  id      String @id @default(uuid())
  code    String @unique
  name    String @unique
  version Int    @default(1)

  items Item[]

  @@map("categories")
}

model UnitOfMeasure {
  id      String @id @default(uuid())
  name    String @unique
  code    String @unique
  version Int    @default(1)

  items           Item[]
  fromConversions UomConversion[] @relation("FromUomConversions")
  toConversions   UomConversion[] @relation("ToUomConversions")

  @@map("units_of_measure")
}

model Supplier {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  contactEmail String?
  contactName  String?
  contactPhone String?
  paymentTerms String? @default("NET_30")
  isActive     Boolean @default(true)
  version      Int     @default(1)

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Currency {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  symbol   String?
  isBase   Boolean @default(false)
  isActive Boolean @default(true)
  version  Int     @default(1)

  purchaseOrders PurchaseOrder[]
  fxRatesFrom    FXRate[]        @relation("FXFrom")
  fxRatesTo      FXRate[]        @relation("FXTo")

  @@map("currencies")
}

model FXRate {
  id             String   @id @default(uuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal  @db.Decimal(18, 6)
  effectiveFrom  DateTime
  isActive       Boolean  @default(true)
  version        Int      @default(1)

  fromCurrency Currency @relation("FXFrom", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency   Currency @relation("FXTo", fields: [toCurrencyId], references: [id], onDelete: Restrict)

  @@unique([fromCurrencyId, toCurrencyId, effectiveFrom])
  @@map("fx_rates")
}

model Item {
  id           String   @id @default(uuid())
  categoryId   String
  uomId        String
  name         String
  sku          String   @unique
  isBatched    Boolean  @default(false)
  hasExpiry    Boolean  @default(false)
  isActive     Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  reorderPoint  Decimal? @db.Decimal(18, 4)
  minStockLevel Decimal? @db.Decimal(18, 4)
  image         String?

  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitOfMeasure       UnitOfMeasure        @relation(fields: [uomId], references: [id], onDelete: Restrict)
  barcodeMappings     BarcodeMapping[]
  uomConversions      UomConversion[]
  prLines             PRLine[]
  poLines             POLine[]
  grnLines            GRNLine[]
  issueLines          InventoryIssueLine[]
  transferLines       TransferLine[]
  adjustmentLines     AdjustmentLine[]
  kitchenRequestItems KitchenRequestItem[]
  lots                Lot[]
  warehouseItems      WarehouseItem[]
  warehouseItemLots   WarehouseItemLot[]
  stockLedgers        StockLedger[]
  costLedgers         CostLedger[]
  stocktakeCounts     StocktakeCount[]
  stocktakeSnapshots  StocktakeSnapshot[]

  @@map("items")
}

model BarcodeMapping {
  id      String @id @default(uuid())
  itemId  String
  barcode String @unique
  version Int    @default(1)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("barcode_mappings")
}

model UomConversion {
  id        String  @id @default(uuid())
  itemId    String
  fromUomId String
  toUomId   String
  factor    Decimal @db.Decimal(18, 6)

  item    Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromUom UnitOfMeasure @relation("FromUomConversions", fields: [fromUomId], references: [id], onDelete: Restrict)
  toUom   UnitOfMeasure @relation("ToUomConversions", fields: [toUomId], references: [id], onDelete: Restrict)

  @@map("uom_conversions")
}

// ─── Tier 2: Transaction Documents ─────────────────────────────────

model PurchaseRequest {
  id            String   @id @default(uuid())
  requestNumber String   @unique
  branchId      String
  warehouseId   String
  departmentId  String?
  status        PRStatus @default(DRAFT)
  createdById   String
  version       Int      @default(1)
  createdAt     DateTime @default(now())

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines          PRLine[]
  purchaseOrders PurchaseOrder[]

  @@map("purchase_requests")
}

model PRLine {
  id       String  @id @default(uuid())
  prId     String
  itemId   String
  quantity Decimal @db.Decimal(18, 4)

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("pr_lines")
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  prId        String? // Task 1.5: removed @unique to allow 1 PR → N POs
  supplierId  String
  warehouseId String?
  status      POStatus @default(DRAFT)
  currencyId  String
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  purchaseRequest    PurchaseRequest?    @relation(fields: [prId], references: [id], onDelete: SetNull)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  currency           Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  lines              POLine[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@map("purchase_orders")
}

model POLine {
  id        String  @id @default(uuid())
  poId      String
  itemId    String
  quantity  Decimal @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("po_lines")
}

model GoodsReceivedNote {
  id               String    @id @default(uuid())
  grnNumber        String    @unique
  poId             String
  warehouseId      String
  status           GRStatus  @default(DRAFT)
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  // ── Task 1.2: Audit & Financial fields ────────────────────────────
  notes            String?
  createdById      String?
  postedAt         DateTime?
  fxRate           Decimal?  @db.Decimal(18, 6) // FX rate snapshot at GRN creation (foreign → base)
  fxRateCapturedAt DateTime? @map("fx_rate_captured_at") // When the rate was captured
  // ──────────────────────────────────────────────────────────────────

  purchaseOrder       PurchaseOrder           @relation(fields: [poId], references: [id], onDelete: Restrict)
  warehouse           Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy           User?                   @relation("GRNCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines               GRNLine[]
  landedCostRelations LandedCostGRNRelation[]

  @@index([status])
  @@map("goods_received_notes")
}

model GRNLine {
  id               String   @id @default(uuid())
  grnId            String
  itemId           String
  quantityReceived Decimal  @db.Decimal(18, 4)
  unitPrice        Decimal  @db.Decimal(18, 4) // kept for compatibility — stores foreign price
  unitPriceForeign Decimal? @db.Decimal(18, 4) // explicit: price in PO's currency
  unitPriceBase    Decimal? @db.Decimal(18, 4) // converted to base currency at time of GRN post
  lotId            String?

  goodsReceivedNote     GoodsReceivedNote          @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item                  Item                       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot                   Lot?                       @relation(fields: [lotId], references: [id], onDelete: SetNull)
  landedCostAllocations LandedCostAllocationLine[]

  @@map("grn_lines")
}

model LandedCostVoucher {
  id                 String           @id @default(uuid())
  voucherNumber      String           @unique
  allocationMethod   AllocationMethod
  totalAllocatedCost Decimal          @db.Decimal(18, 4)
  status             LandedCostStatus @default(DRAFT)
  currencyId         String
  exchangeRate       Decimal          @default(1.0) @db.Decimal(18, 6)
  transactionDate    DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  version            Int              @default(1)
  createdById        String

  createdBy    User                       @relation("CreatedVouchers", fields: [createdById], references: [id])
  lines        LandedCostAllocationLine[]
  grnRelations LandedCostGRNRelation[]

  @@map("landed_cost_vouchers")
}

model LandedCostAllocationLine {
  id                  String  @id @default(uuid())
  landedCostVoucherId String
  grnLineId           String
  allocatedCost       Decimal @db.Decimal(18, 4)
  adjustedUnitCost    Decimal @db.Decimal(18, 4)
  version             Int     @default(1)

  voucher LandedCostVoucher @relation(fields: [landedCostVoucherId], references: [id], onDelete: Cascade)
  grnLine GRNLine           @relation(fields: [grnLineId], references: [id], onDelete: Restrict)

  @@map("landed_cost_allocation_lines")
}

model LandedCostGRNRelation {
  id                  String @id @default(uuid())
  landedCostVoucherId String
  grnId               String

  voucher LandedCostVoucher @relation(fields: [landedCostVoucherId], references: [id], onDelete: Cascade)
  grn     GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Restrict)

  @@unique([landedCostVoucherId, grnId])
  @@map("landed_cost_grn_relations")
}

model InventoryIssue {
  id           String      @id @default(uuid())
  issueNumber  String      @unique
  warehouseId  String
  departmentId String
  status       IssueStatus @default(DRAFT)
  notes        String?
  createdById  String?
  postedAt     DateTime?
  version      Int         @default(1)
  createdAt    DateTime    @default(now())

  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  department     Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy      User?                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines          InventoryIssueLine[]
  kitchenRequest KitchenRequest?

  @@map("inventory_issues")
}

model InventoryIssueLine {
  id       String  @id @default(uuid())
  issueId  String
  itemId   String
  quantity Decimal @db.Decimal(18, 4)

  inventoryIssue InventoryIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotAllocations LotAllocation[]

  @@map("inventory_issue_lines")
}

model LotAllocation {
  id                String  @id @default(uuid())
  issueLineId       String?
  transferLineId    String?
  lotId             String
  quantityAllocated Decimal @db.Decimal(18, 4)

  issueLine    InventoryIssueLine? @relation(fields: [issueLineId], references: [id], onDelete: Cascade)
  transferLine TransferLine?       @relation(fields: [transferLineId], references: [id], onDelete: Cascade)
  lot          Lot                 @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([transferLineId])
  @@index([issueLineId])
  @@map("lot_allocations")
}

model Transfer {
  id              String   @id @default(uuid())
  transferNumber  String   @unique
  fromWarehouseId String
  toWarehouseId   String
  status          String   @default("DRAFT")
  version         Int      @default(1)
  notes           String?
  createdAt       DateTime @default(now())

  fromWarehouse Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  lines         TransferLine[]

  @@map("transfers")
}

model TransferLine {
  id               String   @id @default(uuid())
  transferId       String
  itemId           String
  quantityShipped  Decimal  @db.Decimal(18, 4)
  quantityReceived Decimal? @db.Decimal(18, 4)
  unitCost         Decimal? @db.Decimal(18, 4)
  varianceReason   String?
  notes            String?

  transfer       Transfer        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lotAllocations LotAllocation[]

  @@map("transfer_lines")
}

model Adjustment {
  id               String    @id @default(uuid())
  adjustmentNumber String    @unique
  warehouseId      String
  status           AdjStatus @default(DRAFT)
  notes            String?
  createdById      String?
  postedAt         DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines     AdjustmentLine[]

  @@map("adjustments")
}

model AdjustmentLine {
  id                  String              @id @default(uuid())
  adjustmentId        String
  itemId              String
  lotId               String?
  quantity            Decimal             @db.Decimal(18, 4)
  direction           AdjustmentDirection
  reason              AdjustmentReason
  unitCost            Decimal?            @db.Decimal(18, 4)
  snapshotQtyBefore   Decimal?            @map("snapshot_qty_before") @db.Decimal(18, 4)

  adjustment Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot        Lot?       @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@map("adjustment_lines")
}

model KitchenRequest {
  id            String   @id @default(uuid())
  requestNumber String   @unique
  departmentId  String
  warehouseId   String
  status        String   @default("DRAFT")
  version       Int      @default(1)
  issueId       String?  @unique @map("issue_id")
  requestedById String?  @map("requested_by_id")
  notes         String?
  createdAt     DateTime @default(now())

  department     Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requestedBy    User?                @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  inventoryIssue InventoryIssue?      @relation(fields: [issueId], references: [id])
  items          KitchenRequestItem[]

  @@map("kitchen_requests")
}

model YieldBatch {
  id            String     @id @default(uuid())
  recipeName    String     @map("recipe_name")
  category      String
  warehouseId   String?    @map("warehouse_id")
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  // Task 1.6: changed Float → Decimal(18,4) for precise financial calculations
  inputQty      Decimal    @map("input_qty") @db.Decimal(18, 4)
  outputQty     Decimal    @map("output_qty") @db.Decimal(18, 4)
  wasteQty      Decimal    @map("waste_qty") @db.Decimal(18, 4)
  yieldPct      Decimal    @map("yield_pct") @db.Decimal(10, 4)
  standardYield Decimal    @map("standard_yield") @db.Decimal(10, 4)
  efficiency    Decimal    @db.Decimal(10, 4)
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([warehouseId])
  @@map("yield_batches")
}

model KitchenRequestItem {
  id                String  @id @default(uuid())
  requestId         String
  itemId            String
  quantityRequested Decimal @db.Decimal(18, 4)
  quantityFulfilled Decimal @db.Decimal(18, 4)
  notes             String?

  kitchenRequest KitchenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("kitchen_request_items")
}

model ApprovalEvent {
  id              String       @id @default(uuid())
  documentId      String
  documentType    DocumentType
  fromStatus      String
  toStatus        String
  actionPerformed String
  userId          String
  stepNumber      Int
  userRole        Role
  comments        String?
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Composite index for workflow step counting (used in executeTransition)
  @@index([documentId, documentType])
  @@map("approval_events")
}

// ─── Tier 3 & 4: Live Inventory Position & Lots ────────────────────

model Lot {
  id           String    @id @default(uuid())
  itemId       String
  lotNumber    String    @unique
  receivedDate DateTime  @default(now())
  expiryDate   DateTime?
  status       LotStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())

  item               Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  grnLines           GRNLine[]
  lotAllocations     LotAllocation[]
  adjustmentLines    AdjustmentLine[]
  warehouseItemLots  WarehouseItemLot[]
  stockLedgers       StockLedger[]
  stocktakeCounts    StocktakeCount[]
  stocktakeSnapshots StocktakeSnapshot[]

  @@index([itemId, expiryDate(sort: Asc)])
  @@map("lots")
}

model WarehouseItem {
  warehouseId  String
  itemId       String
  qtyOnHand    Decimal  @default(0) @db.Decimal(18, 4)
  qtyAllocated Decimal  @default(0) @db.Decimal(18, 4)
  wac          Decimal  @default(0) @db.Decimal(18, 4)
  isFrozen     Boolean  @default(false) @map("is_frozen")
  updatedAt    DateTime @updatedAt

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lots      WarehouseItemLot[]

  @@id([warehouseId, itemId])
  @@map("warehouse_items")
}

model WarehouseItemLot {
  warehouseId  String
  itemId       String
  lotId        String
  qtyOnHand    Decimal  @default(0) @db.Decimal(18, 4)
  qtyAllocated Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt    DateTime @updatedAt

  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot           Lot           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouseItem WarehouseItem @relation(fields: [warehouseId, itemId], references: [warehouseId, itemId], onDelete: Cascade)

  @@id([warehouseId, itemId, lotId])
  @@index([warehouseId, itemId])
  @@index([warehouseId, itemId, qtyOnHand])
  @@map("warehouse_item_lots")
}

// ─── Tier 5: Immutable Ledgers ─────────────────────────────────────

model StockLedger {
  id             String       @id @default(uuid())
  postedAt       DateTime     @default(now())
  warehouseId    String
  itemId         String
  lotId          String?
  quantity       Decimal      @db.Decimal(18, 4)
  documentId     String
  documentType   DocumentType
  idempotencyKey String       @unique

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot       Lot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([warehouseId, itemId, postedAt(sort: Desc)])
  @@index([warehouseId, itemId])
  @@index([documentId])
  @@map("stock_ledger")
}

model CostLedger {
  id             String       @id @default(uuid())
  postedAt       DateTime     @default(now())
  warehouseId    String
  itemId         String
  quantity       Decimal      @db.Decimal(18, 4)
  unitPrice      Decimal      @db.Decimal(18, 4)
  newWac         Decimal      @db.Decimal(18, 4)
  documentId     String
  documentType   DocumentType
  idempotencyKey String       @unique
  archivedAt     DateTime?    @map("archived_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([warehouseId, itemId, postedAt(sort: Desc)])
  @@index([documentId])
  @@index([documentId, documentType])
  @@map("cost_ledger")
}

// ─── Tier 6: Control & Security ────────────────────────────────────

model WarehouseLock {
  id          String     @id @default(uuid())
  warehouseId String
  lockType    LockType
  status      LockStatus @default(ACTIVE)
  lockedById  String
  expiresAt   DateTime
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lockedBy  User      @relation(fields: [lockedById], references: [id], onDelete: Restrict)

  @@index([isActive, expiresAt])
  @@index([warehouseId, isActive])
  @@map("warehouse_locks")
}

model IdempotencyLog {
  key          String   @id
  responseBody String
  statusCode   Int
  createdAt    DateTime @default(now())

  @@map("idempotency_logs")
}

model AuditLog {
  id              String   @id @default(uuid())
  userId          String?
  action          String
  targetTable     String
  targetId        String
  beforeStateJson String
  afterStateJson  String
  ipAddress       String?
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Indexes for incident investigation and audit queries
  @@index([targetTable, targetId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model StocktakeSession {
  id            String          @id @default(uuid())
  sessionNumber String          @unique
  warehouseId   String
  status        StocktakeStatus @default(DRAFT)
  version       Int             @default(1)
  createdAt     DateTime        @default(now())

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  counts    StocktakeCount[]
  snapshots StocktakeSnapshot[]

  @@map("stocktake_sessions")
}

model StocktakeCount {
  id          String   @id @default(uuid())
  sessionId   String
  itemId      String
  lotId       String?
  qtyCounted  Decimal  @db.Decimal(18, 4)
  countedById String
  countedAt   DateTime @default(now())

  session   StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item      Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot       Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  countedBy User             @relation(fields: [countedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, itemId, lotId])
  @@map("stocktake_counts")
}

model StocktakeSnapshot {
  id          String   @id @default(uuid())
  sessionId   String
  itemId      String
  lotId       String?
  qtySnapshot Decimal  @db.Decimal(18, 4)
  wacSnapshot Decimal  @db.Decimal(18, 4)
  createdAt   DateTime @default(now())

  session StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot     Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@map("stocktake_snapshots")
}

model NotificationLog {
  id           String        @id @default(uuid())
  targetRole   Role
  warehouseId  String?
  message      String
  isRead       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  documentType DocumentType?
  documentId   String?

  @@index([targetRole, isRead])
  @@index([warehouseId])
  @@index([createdAt(sort: Desc)]) // Enables efficient TTL-based cleanup
  @@map("notification_logs")
}

model DocumentSequence {
  id              String       @id @default(uuid())
  branchId        String       @map("branch_id")
  documentType    DocumentType @map("document_type")
  year            Int
  currentSequence Int          @default(0) @map("current_sequence")
  prefix          String
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([documentType, year, branchId])
  @@map("document_sequences")
}

model OutboxEvent {
  id           String       @id @default(uuid())
  eventType    String
  payload      Json
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  documentId   String?
  eventHash    String?      @map("event_hash") @db.VarChar(64)
  deadLettered Boolean      @default(false) @map("dead_lettered")
  retryHistory Json?        @map("retry_history")

  @@index([deadLettered, status, createdAt])
  @@map("outbox_events")
}

model ReconciliationRun {
  id                    String   @id @default(uuid())
  ranAt                 DateTime @default(now())
  itemsChecked          Int
  discrepanciesFound    Int
  lotDiscrepanciesFound Int      @default(0) @map("lot_discrepancies_found")
  wacDriftCount         Int      @default(0) @map("wac_drift_count")
  frozenItems           String[]
  durationMs            Int

  @@map("reconciliation_runs")
}

model SystemSetting {
  key       String   @id
  value     String // Encrypted configuration string
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model AuditLogArchive {
  id              String   @id
  userId          String?
  action          String
  targetTable     String
  targetId        String
  beforeStateJson String
  afterStateJson  String
  ipAddress       String?
  createdAt       DateTime
  integrityHash   String?  @map("integrity_hash") @db.VarChar(64)

  @@map("audit_logs_archive")
}

model StockLedgerArchive {
  id                String       @id
  postedAt          DateTime
  warehouseId       String
  itemId            String
  lotId             String?
  quantity          Decimal      @db.Decimal(18, 4)
  documentId        String
  documentType      DocumentType
  idempotencyKey    String?
  integrityHash     String?      @map("integrity_hash") @db.VarChar(64)
  costLedgerEntries Json?        @map("cost_ledger_entries")

  @@map("stock_ledger_archive")
}

model CostLedgerArchive {
  id             String       @id
  postedAt       DateTime
  warehouseId    String
  itemId         String
  quantity       Decimal      @db.Decimal(18, 4)
  unitPrice      Decimal      @db.Decimal(18, 4)
  newWac         Decimal      @db.Decimal(18, 4)
  documentId     String
  documentType   DocumentType
  idempotencyKey String?
  integrityHash  String?      @map("integrity_hash") @db.VarChar(64)

  @@map("cost_ledger_archive")
}

model DocumentCounter {
  docType    String   @map("doc_type")
  branchCode String   @map("branch_code")
  year       Int
  lastSeq    Int      @default(0) @map("last_seq")

  @@id([docType, branchCode, year])
  @@index([docType, branchCode, year])
  @@map("document_counters")
}

model EmailTemplate {
  id                String   @id @default(uuid())
  code              String   @unique
  subjectAr         String?  @map("subject_ar")
  subjectEn         String?  @map("subject_en")
  bodyAr            String?  @map("body_ar")
  bodyEn            String?  @map("body_en")
  triggerEvent      String   @map("trigger_event")
  isActive          Boolean  @default(true) @map("is_active")
  allowedParameters Json?    @map("allowed_parameters")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

