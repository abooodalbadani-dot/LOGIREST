# ==========================================
# LogiRest Inventory Management — Production Environment Variables Template
# ==========================================

# Required in Production
DATABASE_URL="postgresql://user:pass@host:5432/logirest?sslmode=require&lock_timeout=5000&connect_timeout=10"
PORT=4000
FRONTEND_URL="https://your-domain.com"
NODE_ENV="production"

# JWT Secret Keys (Must be strong, secure random keys at least 32 characters long)
JWT_ACCESS_SECRET="min-32-character-random-secret-key-for-jwt-access-tokens"
JWT_REFRESH_SECRET="min-32-character-random-secret-key-for-jwt-refresh-tokens"

# Optional & System Controls
IDEMPOTENCY_TTL_HOURS=24
TRANSFER_OVERDUE_DAYS=7
REDIS_URL="redis://localhost:6379"
ENCRYPTION_KEY="replace-with-min-32-char-random-key-for-aes-256-gcm"

# Validation Alert Settings (Sprint 2)
SLACK_VALIDATION_WEBHOOK_URL=""
VALIDATION_ALERT_EMAILS=""

# Notification Mail Settings (SMTP Configuration)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@logirest.app"

# Seeding Credentials (Only used during initial database seeding; delete/rotate post-initialization)
INITIAL_ADMIN_EMAIL="admin@logirest.app"
# WARNING: Change this password immediately after first login via the user profile settings page.
INITIAL_ADMIN_PASSWORD="change-me-immediately"
INITIAL_ADMIN_NAME="System Administrator"
