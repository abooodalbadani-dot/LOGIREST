# ==============================================================================
# OTANTIK KITCHEN / LogiRest — DEFINITIVE PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
#
# USAGE:
#   1. Copy this file:
#        cp .env.production.example .env.prod
#   2. Fill in EVERY value marked <CHANGE_ME> or generate_secure_*
#   3. NEVER commit .env.prod, .env.production, or .env to version control
#   4. Recommended secret store: Docker Secrets, HashiCorp Vault, or AWS SSM
#
# SECRET GENERATION HELPERS:
#   64-char hex  (JWT, AES-256 keys):  openssl rand -hex 32
#   44-char b64  (passwords):          openssl rand -base64 32
#   Short token  (MinIO user/pass):    openssl rand -base64 18
#
# DEPLOY COMMAND:
#   DOCKER_BUILDKIT=1 docker compose \
#     -f docker-compose.prod.yml \
#     --env-file .env.prod \
#     up -d --build
#
# FIRST-BOOT SEED:
#   docker compose -f docker-compose.prod.yml exec api npm run prisma:seed
# ==============================================================================


# ------------------------------------------------------------------------------
# SECTION 1 — SYSTEM CONFIG
# Domains used by Caddy reverse proxy and ACME (Let's Encrypt) SSL provisioning.
# The Caddyfile reads ${DOMAIN} and ${API_DOMAIN} at runtime.
# ------------------------------------------------------------------------------

# Primary domain for the Next.js web application (Caddy → web:3000)
DOMAIN=app.yourdomain.com

# Subdomain for the NestJS API (Caddy → api:4000)
API_DOMAIN=api.yourdomain.com

# Optional: subdomain for Grafana monitoring console
MONITORING_DOMAIN=monitoring.yourdomain.com

# Email address used by Caddy to register TLS certificates via Let's Encrypt.
# Without a valid email, automatic HTTPS will NOT work.
ACME_EMAIL=ops@yourdomain.com

# BuildKit — always enabled for production builds (required for cache mounts)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1


# ------------------------------------------------------------------------------
# SECTION 2 — NESTJS API CONFIG  (service: api, container: logirest-api)
# Port 4000 is exposed only inside the Docker network; Caddy proxies externally.
# ------------------------------------------------------------------------------

NODE_ENV=production
PORT=4000
NODE_OPTIONS=--max-old-space-size=1024

# Public-facing URL of the Next.js frontend — added to the CORS allow-list.
# Must match your actual production domain including scheme (https://).
FRONTEND_URL=https://app.yourdomain.com

# JWT Secrets — MUST be >= 64 hex characters, cryptographically random.
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=generate_secure_64_char_hex_string_for_access_token_signing
JWT_REFRESH_SECRET=generate_secure_64_char_hex_string_for_refresh_token_signing

# AES-256-GCM key for encrypting SMTP passwords stored in the database.
# MUST be exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=generate_secure_64_char_hex_string_for_aes_256_gcm_encryption

# Idempotency key TTL (hours) — prevents duplicate transactions on retry
IDEMPOTENCY_TTL_HOURS=24

# Application currency defaults (surfaced to the client and used in reports)
BASE_CURRENCY_CODE=USD
BASE_CURRENCY_NAME=US Dollar

# Number of days before a pending stock transfer is flagged as overdue
TRANSFER_OVERDUE_DAYS=7

# Feature flags — keep both false until explicitly enabled after client briefing
ENABLE_AUTO_FREEZE=false
ENABLE_SLACK_ALERTS=false

# SMTP / Email Notifications — used for OTP, alerts, and password reset emails
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=<CHANGE_ME__smtp_username_or_api_key>
SMTP_PASS=<CHANGE_ME__smtp_password_or_app_password>
SMTP_FROM=noreply@yourdomain.com

# Alert Webhooks — only consumed when ENABLE_SLACK_ALERTS=true
SLACK_VALIDATION_WEBHOOK_URL=https://hooks.slack.com/services/<CHANGE_ME>
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/<CHANGE_ME>
VALIDATION_ALERT_EMAILS=ops@yourdomain.com,admin@yourdomain.com

# Initial Admin Seed Credentials — used ONLY during first-boot database seeding.
# Rotate the password immediately after first login.
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=generate_secure_random_string_here__rotate_on_first_login
INITIAL_ADMIN_NAME=System Administrator


# ------------------------------------------------------------------------------
# SECTION 3 — NEXT.JS WEB CONFIG  (service: web, container: logirest-web)
# Port 3000 is exposed only inside the Docker network; Caddy proxies externally.
#
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the client-side bundle at
# BUILD TIME via Docker build ARGs. They cannot be changed at runtime without
# rebuilding the image. See docker-compose.prod.yml → web.build.args.
# ------------------------------------------------------------------------------

# Public API URL — embedded in the browser bundle at build time.
# Must be the externally reachable HTTPS URL of the NestJS API.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Server-side API URL — used by Next.js SSR / Server Components to reach the
# API via the internal Docker network (bypasses Caddy, no TLS overhead).
API_URL=http://api:4000/api/v1

# Always false in production — disables MSW mock service worker
NEXT_PUBLIC_USE_MOCKS=false

# Operational config surfaced to the client (must match API value above)
NEXT_PUBLIC_TRANSFER_OVERDUE_DAYS=7


# ------------------------------------------------------------------------------
# SECTION 4 — POSTGRESQL 16 CONFIG  (service: db, container: logirest-db)
# The DB container is NEVER exposed to the host; only reachable inside the
# Docker network. All services connect via the service name "db".
# Do NOT use "localhost" or "127.0.0.1" — use "db" as the hostname.
# ------------------------------------------------------------------------------

# PostgreSQL credentials for the logirest application database
POSTGRES_USER=logirest_prod
POSTGRES_PASSWORD=generate_secure_random_string_here__at_least_32_chars
POSTGRES_DB=logirest

# Legacy aliases consumed by docker-compose.prod.yml environment interpolation
DB_USER=logirest_prod
DB_PASSWORD=generate_secure_random_string_here__at_least_32_chars
DB_NAME=logirest

# Prisma DATABASE_URL — uses the internal Docker service name "db" as the host.
# Replace both placeholder passwords with the same value as DB_PASSWORD above.
DATABASE_URL="postgresql://logirest_prod:generate_secure_random_string_here@db:5432/logirest?sslmode=disable&lock_timeout=5000&connect_timeout=10"

# Prisma DIRECT_URL — bypasses PgBouncer for schema migrations
DIRECT_URL="postgresql://logirest_prod:generate_secure_random_string_here@db:5432/logirest?sslmode=disable&lock_timeout=5000&connect_timeout=10"


# ------------------------------------------------------------------------------
# SECTION 5 — REDIS 7 CONFIG  (service: redis, container: logirest-redis)
# Redis is NEVER exposed to the host; only reachable inside the Docker network.
# The compose service name "redis" resolves automatically within the network.
# ------------------------------------------------------------------------------

# Full Redis connection URL — used by the NestJS API (BullMQ, cache, sessions)
# If REDIS_PASSWORD is set, update to: redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://redis:6379

# Individual connection fields (used if your config module prefers host/port)
REDIS_HOST=redis
REDIS_PORT=6379

# Redis AUTH password — strongly recommended in production.
# If set, also update the compose redis command:
#   redis-server --requirepass ${REDIS_PASSWORD} --appendonly yes
REDIS_PASSWORD=generate_secure_random_string_here__redis_auth_password


# ------------------------------------------------------------------------------
# SECTION 6 — MINIO CONFIG  (service: minio, container: logirest-minio)
# S3-compatible object storage for database backups and user file uploads.
# API port 9000 is internal-only; admin console 9001 is bound to 127.0.0.1.
# Create restricted service account credentials via the console after first boot.
# ------------------------------------------------------------------------------

# MinIO root credentials (equivalent to AWS root account — use for admin only)
MINIO_ROOT_USER=<CHANGE_ME__minio_root_username_min_3_chars>
MINIO_ROOT_PASSWORD=generate_secure_random_string_here__minio_root_pass_min_8_chars

# S3-compatible service account credentials used by the API backup service.
# These map to MINIO_ROOT_USER / MINIO_ROOT_PASSWORD via compose interpolation
# until a dedicated service account is created via the MinIO console.
BACKUP_S3_ACCESS_KEY_ID=<CHANGE_ME__minio_service_account_access_key>
BACKUP_S3_SECRET_ACCESS_KEY=generate_secure_random_string_here__minio_service_account_secret

# Legacy aliases (resolved by docker-compose.prod.yml fallback expressions)
BACKUP_S3_ACCESS_KEY=<CHANGE_ME__minio_service_account_access_key>
BACKUP_S3_SECRET_KEY=generate_secure_random_string_here__minio_service_account_secret

# MinIO endpoint — always use the internal Docker service name.
# The API connects via the Docker network, NOT via the public internet.
BACKUP_S3_ENDPOINT=http://minio:9000

# S3 region — MinIO ignores this but some S3 SDK clients require a non-empty value
BACKUP_S3_REGION=us-east-1

# Bucket name for database dump uploads (created by the backup script on first run)
BACKUP_S3_BUCKET=logirest-backups

# AES-256 key used to encrypt database dump files BEFORE uploading to MinIO.
# MUST be exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=generate_secure_64_char_hex_string_for_backup_file_encryption


# ------------------------------------------------------------------------------
# SECTION 7 — MONITORING  (service: grafana, container: logirest-grafana)
# Prometheus scrapes http://api:4000/metrics automatically via prometheus.yml.
# Prometheus itself requires no env vars.
# ------------------------------------------------------------------------------

# Grafana admin credentials — change immediately after first login
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=generate_secure_random_string_here__grafana_admin_password

# Disable self-registration (must remain false in production)
GF_USERS_ALLOW_SIGN_UP=false

# Root URL used for absolute links in Grafana alert notification emails
GF_SERVER_ROOT_URL=https://monitoring.yourdomain.com

# Disable anonymous read-only access (must remain false in production)
GF_AUTH_ANONYMOUS_ENABLED=false


# ------------------------------------------------------------------------------
# SECTION 8 — BACKUPS  (service: db-backup, container: logirest-db-backup)
# The db-backup sidecar runs scripts/db-backup.sh on the cron schedule below.
# Dumps are AES-256 encrypted with BACKUP_ENCRYPTION_KEY before MinIO upload.
# ------------------------------------------------------------------------------

# Cron schedule for automated database backups (default: 02:00 UTC daily)
# Format: minute hour day-of-month month day-of-week
# Examples:
#   "0 2 * * *"   — every day at 02:00 UTC
#   "0 2 * * 0"   — every Sunday at 02:00 UTC
#   "0 */6 * * *" — every 6 hours
BACKUP_CRON_SCHEDULE=0 2 * * *

# Number of days to retain backup files in MinIO before automatic deletion.
# Set to 0 to disable automatic deletion (manage lifecycle via MinIO console).
BACKUP_RETENTION_DAYS=30


# ==============================================================================
# SECTION 9 — LEGACY / V2 SCAFFOLDING  (DO NOT PROVISION)
# These vars are referenced by leftover Supabase utility files located at
# apps/web/src/utils/supabase/. Those files are out-of-MVP-scope and must be
# moved to _v2-features/ before go-live. Do NOT set these in production.
# ==============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase_anon_key>
