# ==============================================================================
# LogiRest — UNIFIED PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Usage:
#   1. Copy this file:  cp .env.production.example .env
#   2. Fill in ALL values marked with  <CHANGE_ME>
#   3. NEVER commit .env or .env.production to version control
#   4. Store secrets in a secrets manager (Docker Secrets, Vault, etc.)
#
# Generation helpers:
#   openssl rand -hex 32    -> for 64-char hex secrets
#   openssl rand -base64 32 -> for 44-char base64 secrets
# ==============================================================================

# -------------------------------------------------
# SECTION 1 -- PostgreSQL 16 (service: db)
# -------------------------------------------------
DB_NAME=logirest
DB_USER=logirest_prod
DB_PASSWORD=<CHANGE_ME__use_openssl_rand_base64_24>

# Prisma connection strings -- db host = Docker service name "db"
DATABASE_URL="postgresql://logirest_prod:<CHANGE_ME_DB_PASSWORD>@db:5432/logirest?sslmode=disable&lock_timeout=5000&connect_timeout=10"
DIRECT_URL="postgresql://logirest_prod:<CHANGE_ME_DB_PASSWORD>@db:5432/logirest?sslmode=disable&lock_timeout=5000&connect_timeout=10"

# -------------------------------------------------
# SECTION 2 -- Redis 7 (service: redis)
# -------------------------------------------------
# Internal Docker service name resolves to the Redis container
REDIS_URL=redis://redis:6379

# -------------------------------------------------
# SECTION 3 -- NestJS API (service: api)
# -------------------------------------------------
NODE_ENV=production
PORT=4000

# Public URL of the Next.js frontend -- used for CORS allow-list
FRONTEND_URL=https://app.yourdomain.com

# JWT Secrets -- MUST be >= 32 characters, cryptographically random
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=<CHANGE_ME__64_char_hex_string_for_access_token_signing>
JWT_REFRESH_SECRET=<CHANGE_ME__64_char_hex_string_for_refresh_token_signing>

# AES-256-GCM key for encrypting SMTP passwords at rest -- MUST be exactly 64 hex chars
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=<CHANGE_ME__64_char_hex_string_for_aes_256_gcm>

# Application currency defaults
BASE_CURRENCY_CODE=USD
BASE_CURRENCY_NAME=US Dollar

# Operational thresholds
TRANSFER_OVERDUE_DAYS=7
IDEMPOTENCY_TTL_HOURS=24

# Feature flags (safe defaults -- enable only after client briefing)
ENABLE_AUTO_FREEZE=false
ENABLE_SLACK_ALERTS=false

# -------------------------------------------------
# SECTION 4 -- SMTP / Email Notifications
# -------------------------------------------------
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=<CHANGE_ME__smtp_username_or_email>
SMTP_PASS=<CHANGE_ME__smtp_password_or_app_password>
SMTP_FROM=noreply@yourdomain.com

# -------------------------------------------------
# SECTION 5 -- Validation / Alert Webhooks
# -------------------------------------------------
# Slack webhook URL for reconciliation discrepancy alerts
# (Only active when ENABLE_SLACK_ALERTS=true)
SLACK_VALIDATION_WEBHOOK_URL=https://hooks.slack.com/services/<CHANGE_ME>
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/<CHANGE_ME>

# Comma-separated email list for validation failure alerts
VALIDATION_ALERT_EMAILS=ops@yourdomain.com,admin@yourdomain.com

# -------------------------------------------------
# SECTION 6 -- Initial Admin Seed Credentials
# -------------------------------------------------
# Used ONLY during first-boot database seeding. Rotate immediately after.
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=<CHANGE_ME__rotate_immediately_after_first_login>
INITIAL_ADMIN_NAME=System Administrator

# -------------------------------------------------
# SECTION 7 -- Next.js Web (service: web)
# -------------------------------------------------
# Baked into client bundles at BUILD TIME -- must be the public API URL
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Server-side only -- used by SSR routes to call the API via Docker network
API_URL=http://api:4000/api/v1

# Always false in production -- disables MSW mock service worker
NEXT_PUBLIC_USE_MOCKS=false

# Operational config surfaced to the client
NEXT_PUBLIC_TRANSFER_OVERDUE_DAYS=7

# -------------------------------------------------
# SECTION 8 -- Caddy Reverse Proxy (service: caddy)
# -------------------------------------------------
# Primary domain for the Next.js web app
DOMAIN=app.yourdomain.com

# Subdomain for the NestJS API
API_DOMAIN=api.yourdomain.com

# -------------------------------------------------
# SECTION 9 -- MinIO Object Storage (service: minio)
# -------------------------------------------------
# Root credentials for the MinIO server itself (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)
BACKUP_S3_ACCESS_KEY=<CHANGE_ME__minio_root_user>
BACKUP_S3_SECRET_KEY=<CHANGE_ME__minio_root_password_min_8_chars>

# S3-compatible client credentials used by the API backup service
BACKUP_S3_ACCESS_KEY_ID=<CHANGE_ME__minio_access_key_id>
BACKUP_S3_SECRET_ACCESS_KEY=<CHANGE_ME__minio_secret_access_key>

# MinIO endpoint -- use the internal Docker network address in production
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=logirest-backups

# AES-256 key used to encrypt database dump files before S3 upload
# Generate: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=<CHANGE_ME__64_char_hex_string_for_backup_encryption>

# -------------------------------------------------
# SECTION 10 -- Grafana (service: grafana)
# -------------------------------------------------
# Default admin credentials -- change immediately after first login
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<CHANGE_ME__grafana_admin_password>

# Prevents new user self-registration
GF_USERS_ALLOW_SIGN_UP=false

# Server root URL (used for absolute links in alert emails)
GF_SERVER_ROOT_URL=https://monitoring.yourdomain.com

# Anonymous access (keep disabled in production)
GF_AUTH_ANONYMOUS_ENABLED=false

# -------------------------------------------------
# SECTION 11 -- Prometheus (service: prometheus)
# -------------------------------------------------
# Prometheus does not require env vars -- it reads prometheus.yml directly.
# Scrape target: http://api:4000/metrics (NestJS prom-client endpoint)

# -------------------------------------------------
# SECTION 12 -- Legacy / V2 Scaffolding (DO NOT USE)
# -------------------------------------------------
# These vars are referenced by leftover Supabase utility files at
# apps/web/src/utils/supabase/. Those files are out-of-MVP-scope and must
# be moved to a _v2-features/ directory before go-live. Do NOT provision.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase_anon_key>
