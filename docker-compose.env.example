# Database settings
DB_NAME=logirest
DB_USER=logirest
DB_PASSWORD=your_secure_db_password_here

# JWT Auth secrets (must be at least 32 characters long in production)
# SECURITY WARNING: DO NOT check in actual production secrets! Use a secrets manager (AWS Secrets Manager, Vercel Env, Docker Secrets).
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_chars_long

# AES-256 encryption key for SMTP password storage (min 32 chars)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace_me_with_64_char_hex_string

# Node server settings
PORT=4000
NODE_ENV=production
REDIS_URL=redis://redis:6379

# Public URL of the frontend application (used for CORS)
FRONTEND_URL=https://your-domain.com

# Public URL of the API (baked into Next.js at build time)
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Operational variables configurations
TRANSFER_OVERDUE_DAYS=7
BASE_CURRENCY_CODE=SAR
BASE_CURRENCY_NAME=Saudi Riyal
SMTP_FROM=noreply@logirest.app
